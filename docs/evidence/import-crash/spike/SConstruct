env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})
own = env.Clone()
# godot-cpp appends -std=c++17; replace it for our sources only.
flags = [f for f in own["CXXFLAGS"] if f not in ("-std=c++17", "/std:c++17")]
own.Replace(CXXFLAGS=flags)
own.Append(CXXFLAGS=["/std:c++20"] if own.get("is_msvc", False) else ["-std=c++20"])
own.Append(CPPPATH=["src/"])
lib = own.SharedLibrary("project/bin/libspike{}{}".format(own["suffix"], own["SHLIBSUFFIX"]), Glob("src/*.cpp"))
Default(lib)
