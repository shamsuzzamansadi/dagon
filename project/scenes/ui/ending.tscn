[gd_scene format=3]

[ext_resource type="Theme" path="res://assets/ui/theme.tres" id="theme"]
[ext_resource type="AudioStream" path="res://assets/audio/music/ending.ogg" id="music"]
[ext_resource type="AudioStream" path="res://assets/audio/ambience/night_sea.ogg" id="sea"]
[ext_resource type="Texture2D" path="res://assets/prologue/ending_1_found.png" id="e1"]
[ext_resource type="Texture2D" path="res://assets/prologue/ending_2_listen.png" id="e2"]
[ext_resource type="Texture2D" path="res://assets/prologue/ending_3_shop.png" id="e3"]
[ext_resource type="Texture2D" path="res://assets/prologue/ending_4_rising.png" id="e4"]

[node name="Ending" type="MenuController"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
mode = 2
title_scene_path = "res://scenes/ui/title.tscn"
main_panel_path = NodePath("Center/Card")
credits_panel_path = NodePath("Center/Credits")
first_button_path = NodePath("Center/Card/Items/Continue")
credits_button_path = NodePath("Center/Card/Items/Continue")
credits_back_button_path = NodePath("Center/Credits/Items/MainMenu")
ending_box_path = NodePath("Center/Card/Items/Lines")
voice_path = NodePath("Voice")
panels_path = NodePath("Panels")
ending_lines = PackedStringArray("ending.found", "ending.listen", "ending.innsmouth", "ending.rising")

[node name="Voice" type="AudioStreamPlayer" parent="."]
bus = &"Narration"

[node name="Music" type="AudioStreamPlayer" parent="."]
stream = ExtResource("music")
volume_db = -3.0
autoplay = true
bus = &"Music"

[node name="Sea" type="AudioStreamPlayer" parent="."]
stream = ExtResource("sea")
volume_db = -6.0
autoplay = true
bus = &"Effects"

[node name="Black" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.0392, 0.0549, 0.0941, 1)

[node name="Panels" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Found" type="TextureRect" parent="Panels"]
visible = false
modulate = Color(1, 1, 1, 0)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = ExtResource("e1")
stretch_mode = 5

[node name="Listen" type="TextureRect" parent="Panels"]
visible = false
modulate = Color(1, 1, 1, 0)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = ExtResource("e2")
stretch_mode = 5

[node name="Shop" type="TextureRect" parent="Panels"]
visible = false
modulate = Color(1, 1, 1, 0)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = ExtResource("e3")
stretch_mode = 5

[node name="Rising" type="TextureRect" parent="Panels"]
visible = false
modulate = Color(1, 1, 1, 0)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = ExtResource("e4")
stretch_mode = 5

[node name="Center" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Card" type="PanelContainer" parent="Center"]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = -50.0
offset_right = -24.0
offset_bottom = -6.0
grow_horizontal = 2
grow_vertical = 0

[node name="Items" type="VBoxContainer" parent="Center/Card"]
layout_mode = 2

[node name="Lines" type="VBoxContainer" parent="Center/Card/Items"]
layout_mode = 2

[node name="Continue" type="Button" parent="Center/Card/Items"]
layout_mode = 2
size_flags_horizontal = 8
text = "Continue"

[node name="Credits" type="PanelContainer" parent="Center"]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2

[node name="Items" type="VBoxContainer" parent="Center/Credits"]
layout_mode = 2

[node name="Title" type="Label" parent="Center/Credits/Items"]
layout_mode = 2
text = "Credits"
horizontal_alignment = 1

[node name="Text" type="Label" parent="Center/Credits/Items"]
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
text = "DAGON: Beneath the Black Tide, for GitHub Game Off 2026.\n\nMade by shamsuzzamansadi, who directed, decided and playtested. The code, tests, pixel art scripts and text were written with AI assistance from Claude (Anthropic). ChatGPT (OpenAI) acted as an independent reviewer. No image generators or third-party art. Sound was synthesized by code written the same way. The spoken samples are an AI voice (Chatterbox and Kokoro-82M), for audition only.\n\nBased on \"Dagon\" by H. P. Lovecraft (1919), in the public domain.\n\nMade with Godot Engine, (c) Godot Engine contributors, MIT License, and godot-cpp, MIT License.\n\nCode: MIT License. Original assets: CC BY 4.0."
autowrap_mode = 2

[node name="MainMenu" type="Button" parent="Center/Credits/Items"]
layout_mode = 2
text = "Main Menu"

[connection signal="pressed" from="Center/Card/Items/Continue" to="." method="advance_ending"]
[connection signal="pressed" from="Center/Credits/Items/MainMenu" to="." method="quit_to_main_menu"]
